package q17128;
import java.io.*;
import java.util.*;
class CTJ17128
	{
		public static void main(String args[])
		{
			int i,n;
			Scanner obj=new Scanner(System.in);
			n=obj.nextInt();
			int a[]=new int[n];
			for(i=0;i<n;i++)
				{
					a[i]=obj.nextInt();
				}
			int s=obj.nextInt();
			int l=0,h=n-1,mid=0,count=0;
			while(l<=h)
				{
					mid=(h+l)/2;
					if(a[mid]==s)
					{
						System.out.println(mid);
						count=1;
						break;
					}
					else if(a[mid]<s)
					{
						l=mid+1;
					}
					else
						h=mid-1;
				}
			if(count==0)
				System.out.println("Not found");
		}
	}
